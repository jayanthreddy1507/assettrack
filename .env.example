# Database
DATABASE_URL="postgresql://assetflow_user:assetflow_password@localhost:5432/assetflow?schema=public"
POSTGRES_DB="assetflow"
POSTGRES_USER="assetflow_user"
POSTGRES_PASSWORD="assetflow_password"

# Application
NODE_ENV="development"
APP_NAME="AssetFlow"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL=""

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-base64-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Password/JWT compatibility for the custom login endpoints
JWT_SECRET="replace-with-a-strong-base64-secret"
JWT_EXPIRES_IN="7d"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# API behavior
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
LOG_LEVEL="info"

# Seed data
SEED_ADMIN_PASSWORD="Admin@1234"
