// ─── GENERATOR ─────────────────────────────────────────────────────────────────
// NOTE: In Prisma 7+, the datasource URL is configured in prisma.config.ts
// not here. The datasource block below only declares the provider.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  TECHNICIAN
  EMPLOYEE
  AUDITOR
}

enum AssetStatus {
  ACTIVE
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  DECOMMISSIONED
  LOST
  STOLEN
  RESERVED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum BookingStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
  OVERDUE
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
  RESOLVED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
}

// ─── DEPARTMENTS ───────────────────────────────────────────────────────────────

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  description String?

  parentId    String?     @map("parent_id")
  parent      Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")

  managerId   String?     @map("manager_id")
  manager     User?       @relation("DepartmentManager", fields: [managerId], references: [id])

  users       User[]      @relation("UserDepartment")
  assets      Asset[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  @@index([parentId], map: "idx_departments_parent_id")
  @@map("departments")
}

// ─── USERS ─────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String?
  role          Role           @default(EMPLOYEE)
  status        EmployeeStatus @default(ACTIVE)
  avatar        String?
  phone         String?
  employeeId    String?        @unique @map("employee_id")

  departmentId  String?        @map("department_id")
  department    Department?    @relation("UserDepartment", fields: [departmentId], references: [id])

  managedDepts  Department[]   @relation("DepartmentManager")
  assignedAssets Asset[]       @relation("AssetAssignee")

  accounts      Account[]
  sessions      Session[]

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@index([email], map: "idx_users_email")
  @@index([departmentId], map: "idx_users_department_id")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

// ─── CATEGORIES ────────────────────────────────────────────────────────────────

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  icon        String?

  parentId    String?     @map("parent_id")
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")

  assets      Asset[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

// ─── ASSETS ────────────────────────────────────────────────────────────────────

model Asset {
  id             String      @id @default(uuid())
  name           String
  assetTag       String      @unique @map("asset_tag")
  serialNumber   String?     @unique @map("serial_number")
  description    String?
  status         AssetStatus @default(AVAILABLE)
  metadata       Json?
  purchaseDate   DateTime?   @map("purchase_date")
  purchasePrice  Decimal?    @map("purchase_price") @db.Decimal(12, 2)
  warrantyExpiry DateTime?   @map("warranty_expiry")
  location       String?

  categoryId    String      @map("category_id")
  category      Category    @relation(fields: [categoryId], references: [id])

  departmentId  String?     @map("department_id")
  department    Department? @relation(fields: [departmentId], references: [id])

  assignedToId  String?     @map("assigned_to")
  assignedTo    User?       @relation("AssetAssignee", fields: [assignedToId], references: [id])

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  @@index([status], map: "idx_assets_status")
  @@index([categoryId], map: "idx_assets_category_id")
  @@index([departmentId], map: "idx_assets_department_id")
  @@index([assignedToId], map: "idx_assets_assigned_to")
  @@index([assetTag], map: "idx_assets_tag")
  @@map("assets")
}

// ─── AUTH.JS TABLES ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
